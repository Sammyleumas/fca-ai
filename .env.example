# ---------------------------------------------------------------------------
# MindFlow environment variables. Copy to .env.local for local development and
# set the same keys in Vercel (Project → Settings → Environment Variables).
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase secret / service-role key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Needed for: AI replies & usage metering, account deletion, background jobs, webhooks.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public site URL used in auth emails (verification, password reset, OAuth).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI provider (server only). Default provider is Anthropic.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# Secret for the background worker endpoint (/api/jobs/process), e.g. Vercel Cron.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Database tests (local Postgres 15+). Used by `npm run test:db` only.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/mf_test
