# ---------------------------------------------------------------------------
# FCA-AI environment variables. Copy to .env.local for local development and
# set the same keys in Vercel (Project → Settings → Environment Variables).
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase secret / service-role key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Needed for: AI replies & usage metering, account deletion, background jobs, webhooks.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public site URL used in auth emails (verification, password reset, OAuth).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI (server only): Google Gemini Developer API. Create a key in Google AI Studio:
# https://aistudio.google.com/apikey — never prefix it with NEXT_PUBLIC_ and never commit it.
GEMINI_API_KEY=
# Optional: model override (default gemini-3.8-flash). Check availability for your key with
#   GEMINI_API_KEY=... npm run gemini:check
# GEMINI_MODEL=gemini-3.8-flash

# Secret for the background worker endpoint (/api/jobs/process), e.g. Vercel Cron.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Database tests (local Postgres 15+). Used by `npm run test:db` only.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/mf_test

# --- Billing (Phase 7). Leave blank to keep payments disabled (the app says so honestly). ---
# Stripe (international cards). Create a recurring Product + Prices in the dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
PREMIUM_PRICE_LABEL_USD_MONTHLY=
PREMIUM_PRICE_LABEL_USD_YEARLY=
# Paystack (Nigeria). Create Plans in the dashboard; the secret key also verifies webhooks.
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_PREMIUM_MONTHLY=
PAYSTACK_PLAN_PREMIUM_YEARLY=
PREMIUM_PRICE_LABEL_NGN_MONTHLY=
PREMIUM_PRICE_LABEL_NGN_YEARLY=

# --- Email reminders via Resend (optional). Auth emails use Supabase SMTP instead. ---
RESEND_API_KEY=
EMAIL_FROM="FCA-AI <reminders@yourdomain.com>"
